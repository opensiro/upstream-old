+// AddIssueComment invalidates issue-detail snapshots after a successful write,
+// because those snapshots can carry the most recent comments.
+func (c *CachingClient) AddIssueComment(ctx context.Context, req AddIssueCommentRequest) (AddIssueCommentResult, error) {
+	res, err := c.Inner.AddIssueComment(ctx, req)
+	if err == nil {
+		c.mu.Lock()
+		c.issues = map[string]IssueDetails{}
+		c.mu.Unlock()
+	}
+	return res, err
+}
