@@ -1049,3 +1049,44 @@ func mapStatus(st *gogithub.RepoStatus) CheckRun {
 	}
 	return c
 }
+
+// AddIssueComment rejects PR-shaped issue identities before any mutation.
+func (c *TypedClient) AddIssueComment(ctx context.Context, req AddIssueCommentRequest) (AddIssueCommentResult, error) {
+	var res AddIssueCommentResult
+	if req.Number <= 0 || strings.TrimSpace(req.Body) == "" {
+		return res, fmt.Errorf("add issue comment: positive issue number and nonempty body required")
+	}
+	cl, err := c.init(ctx)
+	if err != nil {
+		return res, err
+	}
+	owner, repo, err := c.resolveOwnerRepo(ctx, req.Owner, req.Repo)
+	if err != nil {
+		return res, err
+	}
+	issue, r, err := cl.Issues.Get(ctx, owner, repo, req.Number)
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("add issue comment: verify issue: %w", classifyAPIError(err))
+	}
+	if issue == nil || issue.PullRequestLinks != nil {
+		return res, ErrIssueNotFound
+	}
+	created, r, err := cl.Issues.CreateComment(ctx, owner, repo, req.Number,
+		&gogithub.IssueComment{Body: gogithub.String(strings.TrimSpace(req.Body))})
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("add issue comment: %w", classifyAPIError(err))
+	}
+	if created != nil {
+		res.URL = created.GetHTMLURL()
+		res.ID = created.GetID()
+	}
+	return res, nil
+}
