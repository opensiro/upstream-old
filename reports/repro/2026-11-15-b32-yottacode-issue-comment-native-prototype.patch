@@ -0,0 +1,53 @@
+package github
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type localIssueCommentHTTP struct {
+	paths    []string
+	postBody []byte
+	isPR     bool
+}
+
+func (rt *localIssueCommentHTTP) RoundTrip(r *http.Request) (*http.Response, error) {
+	rt.paths = append(rt.paths, r.Method+" "+r.URL.Path)
+	status := http.StatusOK
+	payload := `{"number":7,"html_url":"https://github.com/o/r/issues/7"}`
+	if r.Method == "GET" && rt.isPR {
+		payload = `{"number":7,"pull_request":{"url":"https://api.github.com/repos/o/r/pulls/7"}}`
+	}
+	if r.Method == "POST" {
+		status = http.StatusCreated
+		rt.postBody, _ = io.ReadAll(r.Body)
+		payload = `{"id":2,"html_url":"https://github.com/o/r/issues/7#issuecomment-2"}`
+	}
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+}
+func TestNativeIssueAddComment_SendsGitHubWriteOnlyAfterIssueCheck(t *testing.T) {
+	t.Setenv("GITHUB_TOKEN", "test-token")
+	rt := &localIssueCommentHTTP{}
+	c := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt}}
+	out, err := c.AddIssueComment(context.Background(), AddIssueCommentRequest{Owner: "o", Repo: "r", Number: 7, Body: "A comment"})
+	if err != nil || out.ID != 2 || out.URL == "" {
+		t.Fatalf("posted: %+v, %v", out, err)
+	}
+	if len(rt.paths) != 2 || rt.paths[0] != "GET /repos/o/r/issues/7" || rt.paths[1] != "POST /repos/o/r/issues/7/comments" {
+		t.Fatalf("unexpected HTTP activity: %v", rt.paths)
+	}
+	var wire map[string]string
+	if err := json.Unmarshal(rt.postBody, &wire); err != nil || wire["body"] != "A comment" {
+		t.Fatalf("wire: %s %v", rt.postBody, err)
+	}
+	rt2 := &localIssueCommentHTTP{isPR: true}
+	c2 := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt2}}
+	_, err = c2.AddIssueComment(context.Background(), AddIssueCommentRequest{Owner: "o", Repo: "r", Number: 7, Body: "No PR comments"})
+	if err != ErrIssueNotFound || len(rt2.paths) != 1 {
+		t.Fatalf("must reject PR, err=%v calls=%v", err, rt2.paths)
+	}
+}
