+package agent
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// Explicit owner/repo wins over the current working directory.
+var issueOwnerPattern = regexp.MustCompile("^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$")
+var issueRepoPattern = regexp.MustCompile("^[A-Za-z0-9_.-]+$")
+
+func parseIssueRepoTarget(s string) (owner, repo string, err error) {
+	if s == "" {
+		return "", "", nil
+	}
+	parts := strings.Split(s, "/")
+	if len(parts) != 2 || !issueOwnerPattern.MatchString(parts[0]) ||
+		!issueRepoPattern.MatchString(parts[1]) || len(parts[1]) > 100 ||
+		parts[1] == "." || parts[1] == ".." {
+		return "", "", fmt.Errorf("repo must be an exact GitHub owner/repo, without URL, whitespace or paths")
+	}
+	return parts[0], parts[1], nil
+}
+func issueTargetDisplay(s string) string {
+	if s == "" {
+		return "<current repository>"
+	}
+	return s
+}
