+package agent
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/yottadynamics/yottacode/internal/github"
+)
+
+type noCheckoutGitHubHTTP struct{ calls []string }
+
+func (f *noCheckoutGitHubHTTP) RoundTrip(r *http.Request) (*http.Response, error) {
+	f.calls = append(f.calls, r.Method+" "+r.URL.Path)
+	if !strings.HasPrefix(r.URL.Path, "/repos/other/project/issues/7") {
+		return &http.Response{StatusCode: 404, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader("{}")), Request: r}, nil
+	}
+	status := 200
+	payload := "{\"number\":7,\"title\":\"Original\",\"html_url\":\"https://github.com/other/project/issues/7\"}"
+	if r.Method == "POST" {
+		status = 201
+		payload = "{\"id\":23,\"html_url\":\"https://github.com/other/project/issues/7#issuecomment-23\"}"
+	}
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+}
+
+func TestCrossRepoFullAgentHTTPWithoutGitCheckout(t *testing.T) {
+	t.Setenv("GITHUB_TOKEN", "test-token-only")
+	recorder := &noCheckoutGitHubHTTP{}
+	// t.TempDir is deliberately NOT a Git checkout. No live GitHub calls.
+	client := &github.TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: recorder}}
+	update := &GHIssueUpdateTool{GH: client}
+	comment := &GHIssueAddCommentTool{GH: client}
+	ctx := context.Background()
+
+	// Legacy mode cannot select a remote repo when cwd has no Git identity.
+	old, err := update.Execute(ctx, "{\"number\":7,\"title\":\"Updated\"}")
+	if err != nil || !strings.Contains(old, "updated=false") || len(recorder.calls) != 0 {
+		t.Fatalf("no-checkout baseline must not write: %q %v calls=%v", old, err, recorder.calls)
+	}
+	// With the same client and the same working directory, the new repo
+	// argument routes both operations to the explicit remote target.
+	out, err := update.Execute(ctx, "{\"repo\":\"other/project\",\"number\":7,\"title\":\"Updated\"}")
+	if err != nil || !strings.Contains(out, "updated=true") {
+		t.Fatalf("explicit update: %q %v", out, err)
+	}
+	out, err = comment.Execute(ctx, "{\"repo\":\"other/project\",\"number\":7,\"body\":\"Verified\"}")
+	if err != nil || !strings.Contains(out, "posted=true") {
+		t.Fatalf("explicit comment: %q %v", out, err)
+	}
+	expected := []string{
+		"GET /repos/other/project/issues/7",
+		"PATCH /repos/other/project/issues/7",
+		"GET /repos/other/project/issues/7",
+		"POST /repos/other/project/issues/7/comments",
+	}
+	if len(recorder.calls) != len(expected) {
+		t.Fatalf("calls=%v", recorder.calls)
+	}
+	for i, x := range expected {
+		if recorder.calls[i] != x {
+			t.Fatalf("call %d=%q expected %q", i, recorder.calls[i], x)
+		}
+	}
+}
