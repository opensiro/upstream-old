+func TestCrossRepoIssueToolsWithoutCheckout(t *testing.T) {
+	ctx := context.Background()
+	// No CwdRef: the caller supplies the full GitHub identity.
+	gh := &fakeGH{readIssueRes: github.IssueDetails{Number: 7, Title: "Issue from other repo"}}
+	r := &GHIssueReadTool{GH: gh}
+	got, err := r.Execute(ctx, "{\"repo\":\"other/project\",\"number\":7}")
+	if err != nil || !strings.Contains(got, "Issue from other repo") ||
+		gh.readIssueReq.Owner != "other" || gh.readIssueReq.Repo != "project" {
+		t.Fatalf("cross-repo read: %q %v req=%+v", got, err, gh.readIssueReq)
+	}
+	lst := &GHIssueListTool{GH: gh}
+	got, err = lst.Execute(ctx, "{\"repo\":\"team/backend\",\"labels\":[\"bug\"]}")
+	if err != nil || gh.listIssuesReq.Owner != "team" || gh.listIssuesReq.Repo != "backend" ||
+		len(gh.listIssuesReq.Labels) != 1 || gh.listIssuesReq.Labels[0] != "bug" {
+		t.Fatalf("cross-repo list: %q %v req=%+v", got, err, gh.listIssuesReq)
+	}
+	commentGH := &issueCommentProbeGH{}
+	commentTool := &GHIssueAddCommentTool{GH: commentGH}
+	if !commentTool.RequiresApproval("") ||
+		!strings.Contains(commentTool.PreviewCall("{\"repo\":\"team/backend\",\"number\":7,\"body\":\"Verified\"}"), "team/backend") {
+		t.Fatal("comment preview must show repo and require approval")
+	}
+	got, err = commentTool.Execute(ctx, "{\"repo\":\"team/backend\",\"number\":7,\"body\":\"Verified\"}")
+	if err != nil || !strings.Contains(got, "posted=true") ||
+		commentGH.req.Owner != "team" || commentGH.req.Repo != "backend" {
+		t.Fatalf("cross-repo comment: %q %v req=%+v", got, err, commentGH.req)
+	}
+	updateGH := &issueUpdateProbeGH{}
+	updateTool := &GHIssueUpdateTool{GH: updateGH}
+	if !updateTool.RequiresApproval("") ||
+		!strings.Contains(updateTool.PreviewCall("{\"repo\":\"other/project\",\"number\":7,\"title\":\"New title\"}"), "other/project") {
+		t.Fatal("update preview must show repo and require approval")
+	}
+	got, err = updateTool.Execute(ctx, "{\"repo\":\"other/project\",\"number\":7,\"title\":\"New title\"}")
+	if err != nil || !strings.Contains(got, "updated=true") ||
+		updateGH.req.Owner != "other" || updateGH.req.Repo != "project" ||
+		updateGH.req.Title == nil || *updateGH.req.Title != "New title" || updateGH.req.Body != nil {
+		t.Fatalf("cross-repo update: %q %v req=%+v", got, err, updateGH.req)
+	}
+	// A missing repository preserves previous cwd-inference semantics.
+	got, err = updateTool.Execute(ctx, "{\"number\":7,\"body\":\"Local\"}")
+	if err != nil || !strings.Contains(got, "updated=true") ||
+		updateGH.req.Owner != "" || updateGH.req.Repo != "" {
+		t.Fatalf("legacy target changed: %q %v %+v", got, err, updateGH.req)
+	}
+}
+
+func TestCrossRepoRejectsMalformedIdentityBeforeAnyWrite(t *testing.T) {
+	ctx := context.Background()
+	for _, bad := range []string{"team", "team/", "/project", " team/project", "team/project ", "team/project/extra", "https://github.com/team/project", "team/..", "team/.", "team/my project"} {
+		c := &issueCommentProbeGH{}
+		u := &issueUpdateProbeGH{}
+		ct := &GHIssueAddCommentTool{GH: c}
+		ut := &GHIssueUpdateTool{GH: u}
+		// JSON encoder ensures test input cannot accidentally invalidate JSON syntax.
+		inputComment := "{\"repo\":" + mustJSONRepo(bad) + ",\"number\":7,\"body\":\"update\"}"
+		inputUpdate := "{\"repo\":" + mustJSONRepo(bad) + ",\"number\":7,\"title\":\"Updated\"}"
+		out, err := ct.Execute(ctx, inputComment)
+		if err != nil || !strings.Contains(out, "reason=validation") || c.calls != 0 {
+			t.Fatalf("comment bad repo %q: %q %v calls=%d", bad, out, err, c.calls)
+		}
+		out, err = ut.Execute(ctx, inputUpdate)
+		if err != nil || !strings.Contains(out, "reason=validation") || u.calls != 0 {
+			t.Fatalf("update bad repo %q: %q %v calls=%d", bad, out, err, u.calls)
+		}
+	}
+}
+
+func mustJSONRepo(s string) string {
+	b, _ := json.Marshal(s)
+	return string(b)
+}
+
+func TestCrossRepoReadRejectsBadTargetBeforeAdapter(t *testing.T) {
+	readGH := &fakeGH{}
+	r := &GHIssueReadTool{GH: readGH}
+	_, err := r.Execute(context.Background(), "{\"repo\":\"other/project/extra\",\"number\":7}")
+	if err == nil || readGH.readIssueReq.Number != 0 {
+		t.Fatalf("read must fail closed: %v %+v", err, readGH.readIssueReq)
+	}
+	lst := &GHIssueListTool{GH: readGH}
+	_, err = lst.Execute(context.Background(), "{\"repo\":\"other/project/extra\"}")
+	if err == nil || readGH.listIssuesReq.Owner != "" {
+		t.Fatalf("list must fail closed: %v %+v", err, readGH.listIssuesReq)
+	}
+}
