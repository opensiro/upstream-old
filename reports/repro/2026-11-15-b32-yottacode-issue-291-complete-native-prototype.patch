@@ -318,3 +318,27 @@ func (c *CachingClient) CreateIssue(ctx context.Context, req CreateIssueRequest)
 	c.mu.Unlock()
 	return res, nil
 }
+
+// AddIssueComment invalidates issue-detail snapshots after a successful write,
+// because those snapshots can carry the most recent comments.
+func (c *CachingClient) AddIssueComment(ctx context.Context, req AddIssueCommentRequest) (AddIssueCommentResult, error) {
+	res, err := c.Inner.AddIssueComment(ctx, req)
+	if err == nil {
+		c.mu.Lock()
+		c.issues = map[string]IssueDetails{}
+		c.mu.Unlock()
+	}
+	return res, err
+}
+
+// UpdateIssue changes read Issue details and list summaries; invalidate both.
+func (c *CachingClient) UpdateIssue(ctx context.Context, req UpdateIssueRequest) (UpdateIssueResult, error) {
+	out, err := c.Inner.UpdateIssue(ctx, req)
+	if err == nil {
+		c.mu.Lock()
+		c.issues = map[string]IssueDetails{}
+		c.issueLists = map[string][]IssueSummary{}
+		c.mu.Unlock()
+	}
+	return out, err
+}
