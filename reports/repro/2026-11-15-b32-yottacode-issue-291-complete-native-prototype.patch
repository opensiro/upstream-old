+		return res, err
+	}
+	owner, repo, err := c.resolveOwnerRepo(ctx, req.Owner, req.Repo)
+	if err != nil {
+		return res, err
+	}
+	issue, r, err := cl.Issues.Get(ctx, owner, repo, req.Number)
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("add issue comment: verify issue: %w", classifyAPIError(err))
+	}
+	if issue == nil || issue.PullRequestLinks != nil {
+		return res, ErrIssueNotFound
+	}
+	created, r, err := cl.Issues.CreateComment(ctx, owner, repo, req.Number,
+		&gogithub.IssueComment{Body: gogithub.String(strings.TrimSpace(req.Body))})
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("add issue comment: %w", classifyAPIError(err))
+	}
+	if created != nil {
+		res.URL = created.GetHTMLURL()
+		res.ID = created.GetID()
+	}
+	return res, nil
+}
+
+// UpdateIssue makes a partial Issue update, never a PR update.
+func (c *TypedClient) UpdateIssue(ctx context.Context, req UpdateIssueRequest) (UpdateIssueResult, error) {
+	var res UpdateIssueResult
+	if req.Number <= 0 || (req.Title == nil && req.Body == nil) {
+		return res, fmt.Errorf("update issue: positive issue number and at least one field are required")
+	}
+	cl, err := c.init(ctx)
+	if err != nil {
+		return res, err
+	}
+	owner, repo, err := c.resolveOwnerRepo(ctx, req.Owner, req.Repo)
+	if err != nil {
+		return res, err
+	}
+	issue, r, err := cl.Issues.Get(ctx, owner, repo, req.Number)
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("update issue: verify: %w", classifyAPIError(err))
+	}
+	if issue == nil || issue.PullRequestLinks != nil {
+		return res, ErrIssueNotFound
+	}
+	change := &gogithub.IssueRequest{}
+	if req.Title != nil {
+		change.Title = req.Title
+	}
+	if req.Body != nil {
+		change.Body = req.Body
+	}
+	edited, r, err := cl.Issues.Edit(ctx, owner, repo, req.Number, change)
+	c.recordRate(r)
+	if err != nil {
+		if errors.Is(classifyAPIError(err), ErrPRNotFound) {
+			return res, ErrIssueNotFound
+		}
+		return res, fmt.Errorf("update issue: %w", classifyAPIError(err))
+	}
+	if edited != nil {
+		res.URL = edited.GetHTMLURL()
+		res.Number = edited.GetNumber()
+	}
+	return res, nil
+}
diff --git a/internal/github/typed_issue_comment_test.go b/internal/github/typed_issue_comment_test.go
new file mode 100644
index 0000000..466922a
--- /dev/null
+++ b/internal/github/typed_issue_comment_test.go
@@ -0,0 +1,113 @@
+package github
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type localIssueCommentHTTP struct {
+	paths    []string
+	postBody []byte
+	isPR     bool
+}
+
+func (rt *localIssueCommentHTTP) RoundTrip(r *http.Request) (*http.Response, error) {
+	rt.paths = append(rt.paths, r.Method+" "+r.URL.Path)
+	status := http.StatusOK
+	payload := `{"number":7,"html_url":"https://github.com/o/r/issues/7"}`
+	if r.Method == "GET" && rt.isPR {
+		payload = `{"number":7,"pull_request":{"url":"https://api.github.com/repos/o/r/pulls/7"}}`
+	}
+	if r.Method == "POST" {
+		status = http.StatusCreated
+		rt.postBody, _ = io.ReadAll(r.Body)
+		payload = `{"id":2,"html_url":"https://github.com/o/r/issues/7#issuecomment-2"}`
+	}
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+}
+func TestNativeIssueAddComment_SendsGitHubWriteOnlyAfterIssueCheck(t *testing.T) {
+	t.Setenv("GITHUB_TOKEN", "test-token")
+	rt := &localIssueCommentHTTP{}
+	c := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt}}
+	out, err := c.AddIssueComment(context.Background(), AddIssueCommentRequest{Owner: "o", Repo: "r", Number: 7, Body: "A comment"})
+	if err != nil || out.ID != 2 || out.URL == "" {
+		t.Fatalf("posted: %+v, %v", out, err)
+	}
+	if len(rt.paths) != 2 || rt.paths[0] != "GET /repos/o/r/issues/7" || rt.paths[1] != "POST /repos/o/r/issues/7/comments" {
+		t.Fatalf("unexpected HTTP activity: %v", rt.paths)
+	}
+	var wire map[string]string
+	if err := json.Unmarshal(rt.postBody, &wire); err != nil || wire["body"] != "A comment" {
+		t.Fatalf("wire: %s %v", rt.postBody, err)
+	}
+	rt2 := &localIssueCommentHTTP{isPR: true}
+	c2 := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt2}}
+	_, err = c2.AddIssueComment(context.Background(), AddIssueCommentRequest{Owner: "o", Repo: "r", Number: 7, Body: "No PR comments"})
+	if err != ErrIssueNotFound || len(rt2.paths) != 1 {
+		t.Fatalf("must reject PR, err=%v calls=%v", err, rt2.paths)
+	}
+}
+
+type localIssueUpdateHTTP struct {
+	calls []string
+	body  []byte
+	isPR  bool
+}
+
+func (rt *localIssueUpdateHTTP) RoundTrip(r *http.Request) (*http.Response, error) {
+	rt.calls = append(rt.calls, r.Method+" "+r.URL.Path)
+	status := http.StatusOK
+	payload := `{"number":7,"html_url":"https://github.com/o/r/issues/7"}`
+	if r.Method == "GET" && rt.isPR {
+		payload = `{"number":7,"pull_request":{"url":"https://api.github.com/repos/o/r/pulls/7"}}`
+	}
+	if r.Method == "PATCH" {
+		rt.body, _ = io.ReadAll(r.Body)
+		payload = `{"number":7,"html_url":"https://github.com/o/r/issues/7"}`
+	}
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(payload)), Request: r}, nil
+}
+func TestNativeUpdateIssue_PreservesOmittedFieldsAndRejectsPR(t *testing.T) {
+	t.Setenv("GITHUB_TOKEN", "test-token")
+	title := "New title"
+	rt := &localIssueUpdateHTTP{}
+	cl := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt}}
+	out, err := cl.UpdateIssue(context.Background(), UpdateIssueRequest{Owner: "o", Repo: "r", Number: 7, Title: &title})
+	if err != nil || out.Number != 7 {
+		t.Fatalf("title-only update %+v: %v", out, err)
+	}
+	if len(rt.calls) != 2 || rt.calls[0] != "GET /repos/o/r/issues/7" || rt.calls[1] != "PATCH /repos/o/r/issues/7" {
+		t.Fatalf("calls=%v", rt.calls)
+	}
+	var wire map[string]any
+	if err := json.Unmarshal(rt.body, &wire); err != nil || wire["title"] != "New title" {
+		t.Fatalf("wire=%s err=%v", rt.body, err)
+	}
+	if _, present := wire["body"]; present {
+		t.Fatalf("body must be omitted on title-only change: %s", rt.body)
+	}
+	body := "Revised body"
+	rt2 := &localIssueUpdateHTTP{}
+	cl2 := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rt2}}
+	_, err = cl2.UpdateIssue(context.Background(), UpdateIssueRequest{Owner: "o", Repo: "r", Number: 7, Body: &body})
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire = map[string]any{}
+	if err := json.Unmarshal(rt2.body, &wire); err != nil || wire["body"] != "Revised body" {
+		t.Fatalf("wire=%s err=%v", rt2.body, err)
+	}
+	if _, present := wire["title"]; present {
+		t.Fatalf("title must be omitted on body-only change: %s", rt2.body)
+	}
+	rtPR := &localIssueUpdateHTTP{isPR: true}
+	clPR := &TypedClient{Cwd: t.TempDir(), HTTPClient: &http.Client{Transport: rtPR}}
+	_, err = clPR.UpdateIssue(context.Background(), UpdateIssueRequest{Owner: "o", Repo: "r", Number: 7, Title: &title})
+	if err != ErrIssueNotFound || len(rtPR.calls) != 1 {
+		t.Fatalf("PR shaped source must block write: %v, %v", err, rtPR.calls)
+	}
+}
