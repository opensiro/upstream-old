@@ -0,0 +1,111 @@
+package agent
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/yottadynamics/yottacode/internal/github"
+)
+
+type issueCommentProbeGH struct {
+	github.Interface
+	calls int
+	req   github.AddIssueCommentRequest
+	err   error
+}
+
+func (p *issueCommentProbeGH) AddIssueComment(_ context.Context, req github.AddIssueCommentRequest) (github.AddIssueCommentResult, error) {
+	p.calls++
+	p.req = req
+	if p.err != nil {
+		return github.AddIssueCommentResult{}, p.err
+	}
+	return github.AddIssueCommentResult{URL: "https://github.com/o/r/issues/7#issuecomment-2", ID: 2}, nil
+}
+func TestIssueAddComment_NewApprovalGatedUserAction(t *testing.T) {
+	fake := &issueCommentProbeGH{}
+	tool := &GHIssueAddCommentTool{GH: fake}
+	if tool.Name() != "issue_add_comment" || !tool.RequiresApproval("") {
+		t.Fatalf("not registered approval-gated tool")
+	}
+	preview := tool.PreviewCall(`{"number":7,"body":"Follow-up **note**"}`)
+	if !strings.Contains(preview, "7") || !strings.Contains(preview, "Follow-up **note**") {
+		t.Fatalf("missing approval preview: %s", preview)
+	}
+	for _, input := range []string{
+		`{"number":0,"body":"ok"}`,
+		`{"number":7,"body":"   "}`,
+	} {
+		out, err := tool.Execute(context.Background(), input)
+		if err != nil || !strings.Contains(out, "reason=validation") || fake.calls != 0 {
+			t.Fatalf("input %s: %s, %v calls %d", input, out, err, fake.calls)
+		}
+	}
+	out, err := tool.Execute(context.Background(), `{"number":7,"body":"Follow-up **note**"}`)
+	if err != nil || !strings.Contains(out, "posted=true") || fake.calls != 1 || fake.req.Number != 7 || fake.req.Body != "Follow-up **note**" {
+		t.Fatalf("new action: %q %v %+v", out, err, fake)
+	}
+	fake.err = github.ErrIssueNotFound
+	out, err = tool.Execute(context.Background(), `{"number":8,"body":"note"}`)
+	if err != nil || !strings.Contains(out, "reason=not_found") {
+		t.Fatalf("missing issue: %q %v", out, err)
+	}
+	fake.err = errors.New("network failure")
+	out, err = tool.Execute(context.Background(), `{"number":8,"body":"note"}`)
+	if err != nil || !strings.Contains(out, "reason=github_error") {
+		t.Fatalf("provider failure: %q %v", out, err)
+	}
+}
+
+type issueUpdateProbeGH struct {
+	github.Interface
+	calls int
+	req   github.UpdateIssueRequest
+	err   error
+}
+
+func (p *issueUpdateProbeGH) UpdateIssue(_ context.Context, req github.UpdateIssueRequest) (github.UpdateIssueResult, error) {
+	p.calls++
+	p.req = req
+	if p.err != nil {
+		return github.UpdateIssueResult{}, p.err
+	}
+	return github.UpdateIssueResult{URL: "https://github.com/o/r/issues/7", Number: req.Number}, nil
+}
+func TestIssueUpdate_NewPartialChangeAndApproval(t *testing.T) {
+	probe := &issueUpdateProbeGH{}
+	tool := &GHIssueUpdateTool{GH: probe}
+	if tool.Name() != "issue_update" || !tool.RequiresApproval("{}") {
+		t.Fatal("approval not required")
+	}
+	preview := tool.PreviewCall(`{"number":7,"title":"New title"}`)
+	if !strings.Contains(preview, "New title") || !strings.Contains(preview, "7") {
+		t.Fatalf("unsafe preview %q", preview)
+	}
+	for _, raw := range []string{
+		`{"number":0,"title":"X"}`,
+		`{"number":7}`,
+		`{"number":7,"title":"  "}`,
+		`{"number":7,"body":"   "}`,
+	} {
+		got, err := tool.Execute(context.Background(), raw)
+		if err != nil || !strings.Contains(got, "reason=validation") || probe.calls != 0 {
+			t.Fatalf("invalid %s: %q %v calls=%d", raw, got, err, probe.calls)
+		}
+	}
+	output, err := tool.Execute(context.Background(), `{"number":7,"title":"New title"}`)
+	if err != nil || !strings.Contains(output, "updated=true") || probe.calls != 1 || probe.req.Title == nil || *probe.req.Title != "New title" || probe.req.Body != nil {
+		t.Fatalf("partial title update: %q %v %+v", output, err, probe)
+	}
+	output, err = tool.Execute(context.Background(), `{"number":7,"body":"Revised body"}`)
+	if err != nil || !strings.Contains(output, "updated=true") || probe.calls != 2 || probe.req.Title != nil || probe.req.Body == nil || *probe.req.Body != "Revised body" {
+		t.Fatalf("partial body update: %q %v %+v", output, err, probe)
+	}
+	probe.err = github.ErrIssueNotFound
+	output, err = tool.Execute(context.Background(), `{"number":8,"title":"New"}`)
+	if err != nil || !strings.Contains(output, "reason=not_found") {
+		t.Fatalf("missing issue: %q %v", output, err)
+	}
+}
