diff --git a/internal/agent/gh_issue_mutation.go b/internal/agent/gh_issue_mutation.go
new file mode 100644
index 0000000..3e012b4
--- /dev/null
+++ b/internal/agent/gh_issue_mutation.go
@@ -0,0 +1,229 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/yottadynamics/yottacode/internal/github"
+)
+
+// GHIssueAddCommentTool adds the first issue-comment mutation to the agent.
+// Tool approval is mandatory; mutation is never performed during preview.
+type GHIssueAddCommentTool struct{ GH github.Interface }
+
+func (t *GHIssueAddCommentTool) Name() string { return "issue_add_comment" }
+func (t *GHIssueAddCommentTool) Description() string {
+	return "Post one top-level GitHub issue comment, after user approval. Requires a positive issue number and a nonempty Markdown body. Never posts to a pull request."
+}
+func (t *GHIssueAddCommentTool) Schema() map[string]any {
+	return map[string]any{"type": "object", "properties": map[string]any{
+		"number": map[string]any{"type": "integer", "description": "GitHub issue number"},
+		"body":   map[string]any{"type": "string", "description": "Comment Markdown (required)"},
+	}, "required": []string{"number", "body"}}
+}
+func (t *GHIssueAddCommentTool) RequiresApproval(string) bool { return true }
+func (t *GHIssueAddCommentTool) PreviewCall(argsJSON string) string {
+	var a struct {
+		Number int    `json:"number"`
+		Body   string `json:"body"`
+	}
+	_ = json.Unmarshal([]byte(argsJSON), &a)
+	return fmt.Sprintf("issue_add_comment(number=%d)\n%s", a.Number, a.Body)
+}
+func (t *GHIssueAddCommentTool) Execute(ctx context.Context, argsJSON string) (string, error) {
+	var a struct {
+		Number int    `json:"number"`
+		Body   string `json:"body"`
+	}
+	if err := json.Unmarshal([]byte(argsJSON), &a); err != nil {
+		return "", fmt.Errorf("issue_add_comment: invalid args: %w", err)
+	}
+	if t.GH == nil {
+		return "", errors.New("issue_add_comment: GitHub adapter unavailable")
+	}
+	r, err := AddIssueComment(ctx, t.GH, github.AddIssueCommentRequest{Number: a.Number, Body: a.Body})
+	if err != nil {
+		return "", err
+	}
+	switch {
+	case r.ValidationErr != "":
+		return "posted=false reason=validation\n" + r.ValidationErr, nil
+	case r.GitHubUnavailable:
+		return "posted=false reason=github_unavailable", nil
+	case r.NotFound:
+		return "posted=false reason=not_found", nil
+	case r.GitHubError != "":
+		return "posted=false reason=github_error\n" + r.GitHubError, nil
+	case r.Posted:
+		return fmt.Sprintf("posted=true url=%s id=%d", r.URL, r.ID), nil
+	default:
+		return "posted=false reason=unknown", nil
+	}
+}
+
+type IssueAddCommentResult struct {
+	Posted            bool
+	URL               string
+	ID                int64
+	ValidationErr     string
+	GitHubUnavailable bool
+	NotFound          bool
+	GitHubError       string
+}
+
+// AddIssueComment is a deterministic preflight: invalid input never reaches GitHub.
+func AddIssueComment(ctx context.Context, gh github.Interface, req github.AddIssueCommentRequest) (IssueAddCommentResult, error) {
+	var r IssueAddCommentResult
+	if req.Number <= 0 {
+		r.ValidationErr = "issue number must be positive"
+		return r, nil
+	}
+	req.Body = strings.TrimSpace(req.Body)
+	if req.Body == "" {
+		r.ValidationErr = "body is empty"
+		return r, nil
+	}
+	if len(req.Body) > prCommentBodyCap {
+		r.ValidationErr = fmt.Sprintf("body is %d chars; cap is %d", len(req.Body), prCommentBodyCap)
+		return r, nil
+	}
+	out, err := gh.AddIssueComment(ctx, req)
+	if errors.Is(err, github.ErrGitHubUnavailable) {
+		r.GitHubUnavailable = true
+		return r, nil
+	}
+	if errors.Is(err, github.ErrIssueNotFound) {
+		r.NotFound = true
+		return r, nil
+	}
+	if err != nil {
+		r.GitHubError = err.Error()
+		return r, nil
+	}
+	r.Posted = true
+	r.URL = out.URL
+	r.ID = out.ID
+	return r, nil
+}
+
+// GHIssueUpdateTool applies only fields the operator explicitly selected.
+type GHIssueUpdateTool struct{ GH github.Interface }
+
+func (t *GHIssueUpdateTool) Name() string { return "issue_update" }
+func (t *GHIssueUpdateTool) Description() string {
+	return "Approval-gated update of an existing GitHub Issue title and/or body; no field is changed unless explicitly given. Rejects PR-shaped identities and accidental empty fields."
+}
+func (t *GHIssueUpdateTool) Schema() map[string]any {
+	return map[string]any{
+		"type": "object",
+		"properties": map[string]any{
+			"number": map[string]any{"type": "integer", "description": "Existing GitHub issue number"},
+			"title":  map[string]any{"type": "string", "description": "New title (omit to leave unchanged)"},
+			"body":   map[string]any{"type": "string", "description": "New body Markdown (omit to leave unchanged)"},
+		}, "required": []string{"number"},
+	}
+}
+func (t *GHIssueUpdateTool) RequiresApproval(string) bool { return true }
+func (t *GHIssueUpdateTool) PreviewCall(argsJSON string) string {
+	var a struct {
+		Number int     `json:"number"`
+		Title  *string `json:"title"`
+		Body   *string `json:"body"`
+	}
+	_ = json.Unmarshal([]byte(argsJSON), &a)
+	var s strings.Builder
+	fmt.Fprintf(&s, "issue_update(number=%d)", a.Number)
+	if a.Title != nil {
+		fmt.Fprintf(&s, "\nTitle: %s", *a.Title)
+	}
+	if a.Body != nil {
+		fmt.Fprintf(&s, "\nBody:\n%s", *a.Body)
+	}
+	return s.String()
+}
+func (t *GHIssueUpdateTool) Execute(ctx context.Context, argsJSON string) (string, error) {
+	var a struct {
+		Number int     `json:"number"`
+		Title  *string `json:"title"`
+		Body   *string `json:"body"`
+	}
+	if err := json.Unmarshal([]byte(argsJSON), &a); err != nil {
+		return "", fmt.Errorf("issue_update: invalid args: %w", err)
+	}
+	if t.GH == nil {
+		return "", errors.New("issue_update: GitHub adapter unavailable")
+	}
+	res, err := UpdateIssue(ctx, t.GH, github.UpdateIssueRequest{Number: a.Number, Title: a.Title, Body: a.Body})
+	if err != nil {
+		return "", err
+	}
+	switch {
+	case res.ValidationErr != "":
+		return "updated=false reason=validation\n" + res.ValidationErr, nil
+	case res.GitHubUnavailable:
+		return "updated=false reason=github_unavailable", nil
+	case res.NotFound:
+		return "updated=false reason=not_found", nil
+	case res.GitHubError != "":
+		return "updated=false reason=github_error\n" + res.GitHubError, nil
+	case res.Updated:
+		return fmt.Sprintf("updated=true url=%s number=%d", res.URL, res.Number), nil
+	default:
+		return "updated=false reason=unknown", nil
+	}
+}
+
+type IssueUpdateResult struct {
+	Updated           bool
+	URL               string
+	Number            int
+	ValidationErr     string
+	GitHubUnavailable bool
+	NotFound          bool
+	GitHubError       string
+}
+
+// UpdateIssue validates the exact requested fields before any adapter mutation.
+func UpdateIssue(ctx context.Context, gh github.Interface, req github.UpdateIssueRequest) (IssueUpdateResult, error) {
+	var res IssueUpdateResult
+	if req.Number <= 0 {
+		res.ValidationErr = "issue number must be positive"
+		return res, nil
+	}
+	if req.Title == nil && req.Body == nil {
+		res.ValidationErr = "title or body is required"
+		return res, nil
+	}
+	if req.Title != nil {
+		if v := validatePRTitle(*req.Title); v != "" {
+			res.ValidationErr = "title: " + v
+			return res, nil
+		}
+	}
+	if req.Body != nil {
+		if strings.TrimSpace(*req.Body) == "" {
+			res.ValidationErr = "empty body would clobber the existing issue body"
+			return res, nil
+		}
+	}
+	out, err := gh.UpdateIssue(ctx, req)
+	if errors.Is(err, github.ErrGitHubUnavailable) {
+		res.GitHubUnavailable = true
+		return res, nil
+	}
+	if errors.Is(err, github.ErrIssueNotFound) {
+		res.NotFound = true
+		return res, nil
+	}
+	if err != nil {
+		res.GitHubError = err.Error()
+		return res, nil
+	}
+	res.Updated = true
+	res.URL = out.URL
+	res.Number = out.Number
+	return res, nil
+}
