+package tools
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/akmatori/mcp-gateway/internal/auth"
+	"github.com/akmatori/mcp-gateway/internal/database"
+	"github.com/akmatori/mcp-gateway/internal/mcp"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+func TestVictoriaLogsRegistryAndOriginalMetricsUnchanged(t *testing.T) {
+	logger := log.New(io.Discard, "", 0)
+	server := mcp.NewServer("akmatori-test", "1.0", logger)
+	registry := NewRegistry(server, logger)
+	registry.registerVictoriaLogsTools()
+	registry.registerVictoriaMetricsTools()
+	defer registry.Stop()
+	got := registry.ListToolsByType("victoria_logs")
+	if len(got) != 5 {
+		t.Fatalf("new LogsQL namespace has %d operations, want 5", len(got))
+	}
+	expected := map[string]bool{"query": true, "hits": true, "field_names": true, "field_values": true, "stats_query": true}
+	for _, item := range got {
+		if !expected[strings.TrimPrefix(item.Name, "victoria_logs.")] {
+			t.Fatalf("unapproved tool %s", item.Name)
+		}
+		details, ok := registry.GetToolDetail(item.Name)
+		if !ok || details.ToolType != "victoria_logs" || len(details.InputSchema.Required) < 3 {
+			t.Fatalf("unavailable native registry details: %+v", details)
+		}
+	}
+	if len(registry.ListToolsByType("victoria_metrics")) != 5 {
+		t.Fatal("existing VictoriaMetrics tools changed")
+	}
+	if !builtInToolNamespaces["victoria_logs"] {
+		t.Fatal("new namespace could be impersonated via MCP proxy")
+	}
+}
+
+func TestVictoriaLogsRegisteredJSONRPCRespectsAuthorization(t *testing.T) {
+	original := database.DB
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "gateway.sqlite")), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	database.DB = db
+	t.Cleanup(func() { database.DB = original; conn, _ := db.DB(); _ = conn.Close() })
+	if err := db.AutoMigrate(&database.ToolType{}, &database.ToolInstance{}, &database.Skill{}); err != nil {
+		t.Fatal(err)
+	}
+	ty := database.ToolType{Name: "victoria_logs"}
+	if err := db.Create(&ty).Error; err != nil {
+		t.Fatal(err)
+	}
+	backendCalls := 0
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		backendCalls++
+		if r.URL.Path != "/select/logsql/query" {
+			t.Errorf("backend wrong path %q", r.URL.Path)
+		}
+		if r.Header.Get("Authorization") != "Bearer local-test-token" {
+			t.Errorf("missing configured backend auth")
+		}
+		_, _ = fmt.Fprint(w, `{"_time":"2026-11-14T19:00:00Z","_msg":"service crash loop","host":"node-a"}`+"\n")
+	}))
+	defer upstream.Close()
+	instance := database.ToolInstance{ToolTypeID: ty.ID, Name: "Logs local", LogicalName: "logs-local", Enabled: true,
+		Settings: database.JSONB{"vl_url": upstream.URL, "vl_auth_method": "bearer_token", "vl_bearer_token": "local-test-token"}}
+	if err := db.Create(&instance).Error; err != nil {
+		t.Fatal(err)
+	}
+	logger := log.New(io.Discard, "", 0)
+	server := mcp.NewServer("akmatori-test", "1.0", logger)
+	registry := NewRegistry(server, logger)
+	registry.registerVictoriaLogsTools()
+	defer registry.Stop()
+	authorizer := auth.NewAuthorizer(time.Hour)
+	defer authorizer.Stop()
+	server.SetAuthorizer(authorizer)
+	args := map[string]interface{}{"query": "myservice", "start": "2026-11-14T18:00:00Z", "end": "2026-11-14T20:00:00Z", "limit": 2, "logical_name": "logs-local"}
+	doCall := func(allowlist interface{}) map[string]interface{} {
+		t.Helper()
+		p := map[string]interface{}{"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": map[string]interface{}{
+			"name": "victoria_logs.query", "arguments": args}}
+		raw, _ := json.Marshal(p)
+		req := httptest.NewRequest(http.MethodPost, "/mcp", bytes.NewReader(raw))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("X-Incident-ID", "case-48")
+		header, _ := json.Marshal(allowlist)
+		req.Header.Set("X-Tool-Allowlist", string(header))
+		rec := httptest.NewRecorder()
+		server.HandleHTTP(rec, req)
+		var result map[string]interface{}
+		if err := json.Unmarshal(rec.Body.Bytes(), &result); err != nil {
+			t.Fatalf("invalid MCP response: %d: %s, %v", rec.Code, rec.Body.String(), err)
+		}
+		return result
+	}
+	// The original gateway authorizer must enforce an explicit deny-all list.
+	deny := doCall([]interface{}{})
+	if deny["error"] == nil {
+		t.Fatalf("explicit empty tool allowlist ignored: %+v", deny)
+	}
+	if backendCalls != 0 {
+		t.Fatalf("unauthorized call reached HTTP backend: %d", backendCalls)
+	}
+	allow := doCall([]auth.AllowlistEntry{{InstanceID: instance.ID, LogicalName: instance.LogicalName, ToolType: "victoria_logs"}})
+	if allow["error"] != nil {
+		t.Fatalf("authorized new LogsQL tool rejected: %+v", allow)
+	}
+	body, _ := json.Marshal(allow)
+	if backendCalls != 1 || !strings.Contains(string(body), "service crash loop") {
+		t.Fatalf("native gateway did not deliver new user log evidence calls=%d response=%s", backendCalls, body)
+	}
+	t.Log("normal JSON-RPC tools/call with first-party per-incident tool allowlist: zero unauthorized backend calls, one permitted LogsQL request")
+}
