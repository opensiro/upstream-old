+// registerVictoriaLogsTools adds a separate read-only LogsQL namespace.
+// This does not extend the VictoriaMetrics PromQL protocol.
+func (r *Registry) registerVictoriaLogsTools() {
+	r.vlTool = victorialogs.New(r.logger, ratelimit.New(VLRatePerSecond, VLRateBurst))
+	type specification struct {
+		name, desc string
+		props      map[string]mcp.Property
+		required   []string
+	}
+	base := map[string]mcp.Property{
+		"query":        {Type: "string", Description: "LogsQL expression (required; max 4096 bytes)"},
+		"start":        {Type: "string", Description: "RFC3339 UTC or offset time; required"},
+		"end":          {Type: "string", Description: "RFC3339 end; max 6 hour window; required"},
+		"logical_name": {Type: "string", Description: "Optional configured victoria_logs instance name"},
+	}
+	// Map cloning avoids shared schema mutation across tools.
+	mk := func(extra map[string]mcp.Property) map[string]mcp.Property {
+		props := make(map[string]mcp.Property, len(base)+len(extra))
+		for k, v := range base {
+			props[k] = v
+		}
+		for k, v := range extra {
+			props[k] = v
+		}
+		return props
+	}
+	specs := []specification{
+		{"query", "Read bounded VictoriaLogs log messages (LogsQL → NDJSON records)", mk(map[string]mcp.Property{"limit": {Type: "integer", Description: "Log records, 1..200 (default 50)"}}), []string{"query", "start", "end"}},
+		{"hits", "Count matching LogsQL hits grouped by step", mk(map[string]mcp.Property{"step": {Type: "string", Description: "Bucket width, 1s..1h"}}), []string{"query", "start", "end", "step"}},
+		{"field_names", "Discover field names present in time-bounded logs", mk(nil), []string{"query", "start", "end"}},
+		{"field_values", "Discover bounded values of a field across matching logs", mk(map[string]mcp.Property{"field": {Type: "string", Description: "Field name (required)"}}), []string{"query", "start", "end", "field"}},
+		{"stats_query", "Evaluate a LogsQL query containing a stats pipe", mk(nil), []string{"query", "start", "end"}},
+	}
+	for _, spec := range specs {
+		name := spec.name
+		r.server.RegisterTool(mcp.Tool{
+			Name: "victoria_logs." + name, Description: spec.desc,
+			InputSchema: mcp.InputSchema{Type: "object", Properties: spec.props, Required: spec.required},
+		}, func(ctx context.Context, incidentID string, args map[string]interface{}) (interface{}, error) {
+			return r.vlTool.Execute(ctx, incidentID, name, args)
+		})
+	}
+}
+
