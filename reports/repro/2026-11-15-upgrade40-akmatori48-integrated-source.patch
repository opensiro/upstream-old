--- /dev/null
+++ b/mcp-gateway/internal/tools/victorialogs/victorialogs.go
@@ -0,0 +1,252 @@
+// Package victorialogs exposes read-only, bounded VictoriaLogs LogsQL requests
+// as an independent provider integration. It does not reuse the VictoriaMetrics
+// Prometheus-response parser: log queries return NDJSON, not a vector.
+package victorialogs
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/akmatori/mcp-gateway/internal/database"
+	"github.com/akmatori/mcp-gateway/internal/ratelimit"
+)
+
+const (
+	defaultLimit = 50
+	maxLimit     = 200
+	maxWindow    = 6 * time.Hour
+	maxBody      = 256 * 1024
+	maxQuery     = 4096
+)
+
+type Config struct {
+	URL, AuthMethod, Token, Username, Password, HeaderName, HeaderValue string
+	VerifySSL                                                           bool
+	Timeout                                                             time.Duration
+}
+type Tool struct {
+	logger  *log.Logger
+	limiter *ratelimit.Limiter
+}
+
+func New(logger *log.Logger, limiter *ratelimit.Limiter) *Tool {
+	return &Tool{logger: logger, limiter: limiter}
+}
+func setting(settings database.JSONB, key string) string {
+	v, _ := settings[key].(string)
+	return strings.TrimSpace(v)
+}
+func parseConfig(settings database.JSONB) (Config, error) {
+	c := Config{
+		URL:         setting(settings, "vl_url"),
+		AuthMethod:  setting(settings, "vl_auth_method"),
+		Token:       setting(settings, "vl_bearer_token"),
+		Username:    setting(settings, "vl_username"),
+		Password:    setting(settings, "vl_password"),
+		HeaderName:  setting(settings, "vl_header_name"),
+		HeaderValue: setting(settings, "vl_header_value"),
+		VerifySSL:   true, Timeout: 10 * time.Second,
+	}
+	if c.AuthMethod == "" {
+		c.AuthMethod = "none"
+	}
+	if v, ok := settings["vl_verify_ssl"].(bool); ok {
+		c.VerifySSL = v
+	}
+	if raw, ok := settings["vl_timeout"].(float64); ok {
+		if raw < 1 || raw > 60 {
+			return c, fmt.Errorf("vl_timeout must be between 1 and 60 seconds")
+		}
+		c.Timeout = time.Duration(raw * float64(time.Second))
+	}
+	if raw, ok := settings["vl_timeout"].(int); ok {
+		if raw < 1 || raw > 60 {
+			return c, fmt.Errorf("vl_timeout must be between 1 and 60 seconds")
+		}
+		c.Timeout = time.Duration(raw) * time.Second
+	}
+	return c, nil
+}
+func (t *Tool) Execute(ctx context.Context, incidentID, operation string, args map[string]interface{}) (string, error) {
+	logicalName, _ := args["logical_name"].(string)
+	creds, err := database.ResolveToolCredentials(ctx, incidentID, "victoria_logs", nil, logicalName)
+	if err != nil {
+		return "", fmt.Errorf("VictoriaLogs credentials unavailable: %w", err)
+	}
+	c, err := parseConfig(creds.Settings)
+	if err != nil {
+		return "", err
+	}
+	return t.execute(ctx, c, operation, args)
+}
+func value(args map[string]interface{}, name string) string {
+	s, _ := args[name].(string)
+	return strings.TrimSpace(s)
+}
+func (t *Tool) execute(ctx context.Context, c Config, operation string, args map[string]interface{}) (string, error) {
+	// Strict allowlist, not arbitrary provider API.
+	switch operation {
+	case "query", "hits", "field_names", "field_values", "stats_query":
+	default:
+		return "", fmt.Errorf("unsupported VictoriaLogs operation")
+	}
+	base, err := url.Parse(c.URL)
+	if err != nil || base == nil || base.User != nil || base.Host == "" ||
+		(base.Scheme != "https" && base.Scheme != "http") || base.RawQuery != "" || base.Fragment != "" ||
+		(base.Path != "" && base.Path != "/") || base.Opaque != "" {
+		return "", fmt.Errorf("vl_url must be an HTTP(S) origin with no path, query, fragment or credentials")
+	}
+	q := value(args, "query")
+	if q == "" || len(q) > maxQuery {
+		return "", fmt.Errorf("LogsQL query must be 1..4096 bytes")
+	}
+	start, err := time.Parse(time.RFC3339, value(args, "start"))
+	if err != nil {
+		return "", fmt.Errorf("start must be RFC3339")
+	}
+	end, err := time.Parse(time.RFC3339, value(args, "end"))
+	if err != nil {
+		return "", fmt.Errorf("end must be RFC3339")
+	}
+	if !end.After(start) || end.Sub(start) > maxWindow {
+		return "", fmt.Errorf("LogsQL time window must be positive and <= 6 hours")
+	}
+	p := url.Values{"query": {q}, "start": {start.Format(time.RFC3339)}, "end": {end.Format(time.RFC3339)}}
+	switch operation {
+	case "query":
+		limit := defaultLimit
+		if raw, ok := args["limit"]; ok {
+			switch v := raw.(type) {
+			case float64:
+				if v != float64(int(v)) {
+					return "", fmt.Errorf("limit must be an integer")
+				}
+				limit = int(v)
+			case int:
+				limit = v
+			default:
+				return "", fmt.Errorf("limit must be an integer")
+			}
+		}
+		if limit < 1 || limit > maxLimit {
+			return "", fmt.Errorf("limit must be between 1 and 200")
+		}
+		p.Set("limit", strconv.Itoa(limit))
+	case "hits":
+		step := value(args, "step")
+		duration, err := time.ParseDuration(step)
+		if err != nil || duration < time.Second || duration > time.Hour {
+			return "", fmt.Errorf("step must be between 1s and 1h")
+		}
+		p.Set("step", step)
+	case "field_values":
+		f := value(args, "field")
+		if f == "" || len(f) > 128 || strings.ContainsAny(f, "\r\n") {
+			return "", fmt.Errorf("field must be a bounded nonempty name")
+		}
+		p.Set("field", f)
+		p.Set("limit", "200")
+	case "field_names":
+		// The official field_names endpoint does not promise a limit parameter.
+	case "stats_query":
+		if !strings.Contains(strings.ToLower(q), "| stats") {
+			return "", fmt.Errorf("stats_query requires a LogsQL stats pipe")
+		}
+		p.Set("time", end.Format(time.RFC3339))
+	}
+	base.Path = "/select/logsql/" + operation
+	if t.limiter != nil {
+		if err := t.limiter.Wait(ctx); err != nil {
+			return "", fmt.Errorf("VictoriaLogs rate limit: %w", err)
+		}
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, base.String(), strings.NewReader(p.Encode()))
+	if err != nil {
+		return "", err
+	}
+	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	switch c.AuthMethod {
+	case "none":
+	case "bearer_token":
+		if c.Token == "" {
+			return "", fmt.Errorf("vl_bearer_token required for bearer auth")
+		}
+		request.Header.Set("Authorization", "Bearer "+c.Token)
+	case "basic_auth":
+		if c.Username == "" {
+			return "", fmt.Errorf("vl_username required for basic auth")
+		}
+		request.SetBasicAuth(c.Username, c.Password)
+	case "custom_header":
+		if !strings.HasPrefix(strings.ToLower(c.HeaderName), "x-") || c.HeaderValue == "" ||
+			strings.ContainsAny(c.HeaderName, "\r\n :") ||
+			strings.ContainsAny(c.HeaderValue, "\r\n") {
+			return "", fmt.Errorf("custom header requires an X-* name and value")
+		}
+		request.Header.Set(c.HeaderName, c.HeaderValue)
+	default:
+		return "", fmt.Errorf("invalid vl_auth_method")
+	}
+	transport := &http.Transport{DisableKeepAlives: true, Proxy: nil}
+	if !c.VerifySSL {
+		transport.TLSClientConfig = &tls.Config{InsecureSkipVerify: true}
+	} //nolint:gosec // explicit owner setting only
+	timeout := c.Timeout
+	if timeout <= 0 || timeout > 60*time.Second {
+		timeout = 10 * time.Second
+	}
+	client := &http.Client{Timeout: timeout, Transport: transport,
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }}
+	resp, err := client.Do(request)
+	if err != nil {
+		return "", fmt.Errorf("VictoriaLogs request failed: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("VictoriaLogs HTTP %d", resp.StatusCode) // never leak auth/proxy error body
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, maxBody+1))
+	if err != nil {
+		return "", err
+	}
+	if len(data) > maxBody {
+		return "", fmt.Errorf("VictoriaLogs response exceeds 256KiB")
+	}
+	if operation == "query" {
+		scanner := bufio.NewScanner(strings.NewReader(string(data)))
+		scanner.Buffer(make([]byte, 1024), maxBody)
+		result := make([]json.RawMessage, 0, defaultLimit)
+		max, _ := strconv.Atoi(p.Get("limit"))
+		for scanner.Scan() {
+			if len(result) >= max {
+				return "", fmt.Errorf("VictoriaLogs returned more lines than requested")
+			}
+			line := scanner.Bytes()
+			if !json.Valid(line) || len(line) == 0 || line[0] != '{' {
+				return "", fmt.Errorf("invalid VictoriaLogs NDJSON")
+			}
+			result = append(result, append(json.RawMessage(nil), line...))
+		}
+		if err := scanner.Err(); err != nil {
+			return "", fmt.Errorf("VictoriaLogs NDJSON: %w", err)
+		}
+		output, err := json.Marshal(result)
+		return string(output), err
+	}
+	if !json.Valid(data) {
+		return "", fmt.Errorf("invalid VictoriaLogs JSON response")
+	}
+	// The other four endpoints return JSON, not NDJSON. Retain the provider
+	// shape so an SRE agent can inspect hits / stats without lossy conversion.
+	return string(data), nil
+}
diff --git a/mcp-gateway/internal/tools/victorialogs/victorialogs_test.go b/mcp-gateway/internal/tools/victorialogs/victorialogs_test.go
new file mode 100644
--- /dev/null
+++ b/mcp-gateway/internal/tools/victorialogs/victorialogs_test.go
@@ -0,0 +1,249 @@
+package victorialogs
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/akmatori/mcp-gateway/internal/database"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+const start = "2026-11-14T18:00:00Z"
+const end = "2026-11-14T20:00:00Z"
+
+func queryArgs() map[string]interface{} {
+	return map[string]interface{}{"query": "myservice", "start": start, "end": end, "limit": 2}
+}
+func TestNativeVictoriaLogsFiveOperationsSourceFirst(t *testing.T) {
+	calls := map[string]int{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = r.ParseForm()
+		calls[r.URL.Path]++
+		if r.Method != http.MethodPost || r.FormValue("query") == "" || r.FormValue("start") != start || r.FormValue("end") != end {
+			t.Errorf("unbounded or invalid query: method=%s params=%v", r.Method, r.Form)
+		}
+		switch r.URL.Path {
+		case "/select/logsql/query":
+			if r.FormValue("limit") != "2" {
+				t.Errorf("limit missing")
+			}
+			_, _ = fmt.Fprint(w, `{"_time":"2026-11-14T19:00:00Z","host":"node-a","_msg":"systemd crash loop: exit 1"}
+{"_time":"2026-11-14T19:01:00Z","host":"node-a","_msg":"service restarted"}
+`)
+		case "/select/logsql/hits":
+			if r.FormValue("step") != "1m" {
+				t.Errorf("step absent")
+			}
+			_, _ = fmt.Fprint(w, `{"hits":[{"fields":{},"timestamps":["2026-11-14T19:00:00Z"],"values":[2],"total":2}]}`)
+		case "/select/logsql/field_names":
+			_, _ = fmt.Fprint(w, `{"values":[{"value":"host","hits":2}]}`)
+		case "/select/logsql/field_values":
+			if r.FormValue("field") != "host" {
+				t.Errorf("field absent")
+			}
+			_, _ = fmt.Fprint(w, `{"values":[{"value":"node-a","hits":2}]}`)
+		case "/select/logsql/stats_query":
+			if r.FormValue("time") != end {
+				t.Errorf("stats time absent")
+			}
+			_, _ = fmt.Fprint(w, `{"status":"success","data":{"resultType":"vector","result":[{"metric":{"host":"node-a"},"value":[1794686400,"2"]}]}}`)
+		default:
+			t.Errorf("unexpected path %s", r.URL.Path)
+			w.WriteHeader(404)
+		}
+	}))
+	defer server.Close()
+	tool := New(log.New(io.Discard, "", 0), nil)
+	config := Config{URL: server.URL, VerifySSL: true, AuthMethod: "none", Timeout: time.Second}
+	for _, op := range []string{"query", "hits", "field_names", "field_values", "stats_query"} {
+		t.Run(op, func(t *testing.T) {
+			args := queryArgs()
+			args["field"] = "host"
+			args["step"] = "1m"
+			if op == "stats_query" {
+				args["query"] = "myservice | stats by(host) count(*)"
+			}
+			value, err := tool.execute(context.Background(), config, op, args)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !json.Valid([]byte(value)) {
+				t.Fatalf("invalid returned JSON: %q", value)
+			}
+			if op == "query" {
+				var rows []map[string]interface{}
+				if err := json.Unmarshal([]byte(value), &rows); err != nil {
+					t.Fatal(err)
+				}
+				if len(rows) != 2 || rows[0]["host"] != "node-a" || !strings.Contains(rows[0]["_msg"].(string), "crash loop") {
+					t.Fatalf("missing new journal evidence %s", value)
+				}
+			}
+		})
+	}
+	if len(calls) != 5 {
+		t.Fatalf("native five operator functions did not all request distinct LogsQL endpoints: %+v", calls)
+	}
+	t.Log("new user task: read actual LogsQL journal crash loop through native, bounded tool; all five requested endpoints wired")
+}
+func TestNativeVictoriaLogsBoundsAndHTTPFailures(t *testing.T) {
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		_ = r.ParseForm()
+		switch r.FormValue("query") {
+		case "badjson":
+			_, _ = fmt.Fprint(w, "{not-json")
+		case "too_many":
+			_, _ = fmt.Fprint(w, `{"_time":"a","_msg":"a"}`+"\n"+`{"_time":"b","_msg":"b"}`+"\n")
+		case "large":
+			_, _ = fmt.Fprint(w, strings.Repeat("a", maxBody+1))
+		case "error_credential":
+			w.WriteHeader(503)
+			_, _ = fmt.Fprint(w, "secret_credential_should_not_leak")
+		default:
+			_, _ = fmt.Fprint(w, `{"_time":"a","_msg":"ok"}`+"\n")
+		}
+	}))
+	defer server.Close()
+	tool := New(log.New(io.Discard, "", 0), nil)
+	c := Config{URL: server.URL, AuthMethod: "none", VerifySSL: true, Timeout: time.Second}
+	cases := []struct {
+		name, op string
+		cfg      Config
+		args     map[string]interface{}
+	}{
+		{"missing_url", "query", Config{AuthMethod: "none"}, queryArgs()},
+		{"invalid_path", "query", Config{URL: server.URL + "/admin", AuthMethod: "none"}, queryArgs()},
+		{"invalid_scheme", "query", Config{URL: "file:///etc/passwd", AuthMethod: "none"}, queryArgs()},
+		{"user_info", "query", Config{URL: "http://name:pass@localhost:99", AuthMethod: "none"}, queryArgs()},
+		{"unknown_op", "delete", c, queryArgs()},
+		{"missing_query", "query", c, map[string]interface{}{"start": start, "end": end}},
+		{"time_inverted", "query", c, map[string]interface{}{"start": end, "end": start, "query": "x"}},
+		{"time_too_long", "query", c, map[string]interface{}{"start": "2026-11-13T00:00:00Z", "end": end, "query": "x"}},
+		{"bad_timestamp", "query", c, map[string]interface{}{"start": "not-date", "end": end, "query": "x"}},
+		{"limit_huge", "query", c, map[string]interface{}{"start": start, "end": end, "query": "x", "limit": 10000}},
+		{"limit_fraction", "query", c, map[string]interface{}{"start": start, "end": end, "query": "x", "limit": 1.2}},
+		{"step_invalid", "hits", c, map[string]interface{}{"start": start, "end": end, "query": "x", "step": "-2s"}},
+		{"field_missing", "field_values", c, queryArgs()},
+		{"stats_pipe_required", "stats_query", c, queryArgs()},
+		{"bearer_missing", "query", Config{URL: server.URL, AuthMethod: "bearer_token"}, queryArgs()},
+		{"bad_json", "query", c, map[string]interface{}{"start": start, "end": end, "query": "badjson"}},
+		{"too_many_lines", "query", c, map[string]interface{}{"start": start, "end": end, "query": "too_many", "limit": 1}},
+		{"too_large", "query", c, map[string]interface{}{"start": start, "end": end, "query": "large"}},
+		{"error_no_secrets", "query", c, map[string]interface{}{"start": start, "end": end, "query": "error_credential"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := tool.execute(context.Background(), tc.cfg, tc.op, tc.args)
+			if err == nil {
+				t.Fatal("unsafe input/response accepted")
+			}
+			if strings.Contains(err.Error(), "secret_credential_should_not_leak") {
+				t.Fatalf("secret response leaked %s", err)
+			}
+		})
+	}
+	if requests != 4 {
+		t.Fatalf("unsafe requests passed input validation: request count %d", requests)
+	}
+	t.Log("bounded LogsQL fail-closed: invalid time/limit, URL, credentials, JSON, oversized body and errors rejected")
+}
+func TestNativeVictoriaLogsAuthAndNoRedirect(t *testing.T) {
+	seen := []string{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.FormValue("query") == "redirect" {
+			w.Header().Set("Location", "https://example.org")
+			w.WriteHeader(302)
+			return
+		}
+		seen = append(seen, r.Header.Get("Authorization")+"|"+r.Header.Get("X-Test-Token"))
+		_, _ = fmt.Fprint(w, `{"_time":"a","_msg":"ok"}`)
+	}))
+	defer server.Close()
+	tool := New(log.New(io.Discard, "", 0), nil)
+	c := Config{URL: server.URL, AuthMethod: "bearer_token", Token: "research-token", VerifySSL: true, Timeout: time.Second}
+	_, err := tool.execute(context.Background(), c, "query", queryArgs())
+	if err != nil || seen[0] != "Bearer research-token|" {
+		t.Fatalf("bearer auth %q %v", seen, err)
+	}
+	c.AuthMethod = "basic_auth"
+	c.Username = "tester"
+	c.Password = "pw"
+	_, err = tool.execute(context.Background(), c, "query", queryArgs())
+	if err != nil || seen[1] != "Basic dGVzdGVyOnB3|" {
+		t.Fatalf("basic auth %q %v", seen, err)
+	}
+	c.AuthMethod = "custom_header"
+	c.HeaderName = "X-Test-Token"
+	c.HeaderValue = "value"
+	_, err = tool.execute(context.Background(), c, "query", queryArgs())
+	if err != nil || seen[2] != "|value" {
+		t.Fatalf("custom header %q %v", seen, err)
+	}
+	c.HeaderName = "Authorization"
+	if _, err = tool.execute(context.Background(), c, "query", queryArgs()); err == nil {
+		t.Fatal("custom Authorization override accepted")
+	}
+	c.AuthMethod = "none"
+	bad := queryArgs()
+	bad["query"] = "redirect"
+	_, err = tool.execute(context.Background(), c, "query", bad)
+	if err == nil || !strings.Contains(err.Error(), "302") {
+		t.Fatalf("redirect was followed %v", err)
+	}
+	t.Log("bearer/basic/custom-header modes, rejected cross-origin redirects")
+}
+func TestNativeVictoriaLogsFirstPartyCredentialResolver(t *testing.T) {
+	prev := database.DB
+	db, err := gorm.Open(sqlite.Open("file:vl-resolver?mode=memory&cache=shared"), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	database.DB = db
+	t.Cleanup(func() { database.DB = prev; conn, _ := db.DB(); _ = conn.Close() })
+	if err := db.AutoMigrate(&database.ToolType{}, &database.ToolInstance{}, &database.Skill{}); err != nil {
+		t.Fatal(err)
+	}
+	ty := database.ToolType{Name: "victoria_logs", Description: "LogsQL"}
+	if err := db.Create(&ty).Error; err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = fmt.Fprint(w, `{"_time":"2026-11-14T19:00:00Z","_msg":"journal unavailable to metrics"}`+"\n")
+	}))
+	defer server.Close()
+	instance := database.ToolInstance{ToolTypeID: ty.ID, Name: "VictoriaLogs local", LogicalName: "vl-site-a", Enabled: true,
+		Settings: database.JSONB{"vl_url": server.URL, "vl_auth_method": "none"}}
+	if err := db.Create(&instance).Error; err != nil {
+		t.Fatal(err)
+	}
+	tool := New(log.New(io.Discard, "", 0), nil)
+	args := queryArgs()
+	args["logical_name"] = "vl-site-a"
+	out, err := tool.Execute(context.Background(), "incident-1", "query", args)
+	if err != nil || !strings.Contains(out, "journal unavailable to metrics") {
+		t.Fatalf("original DB credential lookup → LogsQL native result: %q, %v", out, err)
+	}
+	bad := queryArgs()
+	bad["logical_name"] = "nonexistent"
+	if _, err := tool.Execute(context.Background(), "incident-1", "query", bad); err == nil {
+		t.Fatal("invalid instance name accepted")
+	}
+	if err := db.Model(&instance).Update("enabled", false).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tool.Execute(context.Background(), "incident-1", "query", args); err == nil {
+		t.Fatal("disabled instance allowed")
+	}
+	t.Log("original DB enabled ToolInstance + logical_name credential path integrates native read-only LogsQL tool; disabled/restricted names fail")
+}
