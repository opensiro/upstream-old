+// getVictoriaLogsSchema presents a native configuration form to the UI.
+func getVictoriaLogsSchema() ToolTypeSchema {
+	return ToolTypeSchema{
+		Name:        "victoria_logs",
+		Description: "VictoriaLogs read-only LogsQL logs, hits and field discovery (separate from VictoriaMetrics).",
+		Version:     "1.0.0",
+		SettingsSchema: SettingsSchema{
+			Type: "object", Required: []string{"vl_url"},
+			Properties: map[string]PropertySchema{
+				"vl_url":          {Type: "string", Description: "VictoriaLogs HTTP(S) origin, without path or query", Example: "https://logs.example.com"},
+				"vl_auth_method":  {Type: "string", Description: "Authentication method", Enum: []string{"none", "bearer_token", "basic_auth", "custom_header"}, Default: "none"},
+				"vl_bearer_token": {Type: "string", Description: "Bearer token for bearer_token mode", Secret: true},
+				"vl_username":     {Type: "string", Description: "Basic authentication username", Advanced: true},
+				"vl_password":     {Type: "string", Description: "Basic authentication password", Secret: true, Advanced: true},
+				"vl_header_name":  {Type: "string", Description: "Custom X-* HTTP authentication header name", Advanced: true},
+				"vl_header_value": {Type: "string", Description: "Custom authentication header value", Secret: true, Advanced: true},
+				"vl_verify_ssl":   {Type: "boolean", Description: "Verify TLS certificate", Default: true, Advanced: true},
+				"vl_timeout":      {Type: "integer", Description: "HTTP request deadline, seconds", Default: 10, Minimum: intPtr(1), Maximum: intPtr(60), Advanced: true},
+			},
+		},
+		Functions: []ToolFunction{
+			{Name: "query", Description: "Retrieve bounded log records with LogsQL", Parameters: "query, start, end required; limit 1..200 optional", Returns: "JSON array of NDJSON log objects"},
+			{Name: "hits", Description: "Count matching logs in time buckets", Parameters: "query, start, end, step required", Returns: "VictoriaLogs hits JSON"},
+			{Name: "field_names", Description: "Discover matching log fields", Parameters: "query, start, end required", Returns: "VictoriaLogs values JSON"},
+			{Name: "field_values", Description: "Read bounded values for a log field", Parameters: "query, start, end, field required", Returns: "VictoriaLogs values JSON"},
+			{Name: "stats_query", Description: "Evaluate LogsQL statistics expression", Parameters: "query containing | stats, start, end required", Returns: "Prometheus-compatible JSON"},
+		},
+	}
+}
+
