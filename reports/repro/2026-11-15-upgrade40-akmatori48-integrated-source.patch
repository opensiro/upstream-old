--- /dev/null
+++ b/mcp-gateway/internal/tools/victorialogs/victorialogs_live_test.go
@@ -0,0 +1,140 @@
+package victorialogs
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+// The explicitly opt-in live test uses a real, isolated VictoriaLogs server
+// preloaded with exactly 3 offline research lines:
+//
+//	node-a: one crash loop and one restart; node-b: one stable service.
+//
+// It is skipped under ordinary upstream CI, where no VictoriaLogs instance
+// should be assumed. See the reproducibility receipt for the pinned server.
+func TestVictoriaLogsOfficialV154FiveFunctions(t *testing.T) {
+	origin := os.Getenv("AKMATORI_VL_INTEGRATION_URL")
+	if origin == "" {
+		t.Skip("set AKMATORI_VL_INTEGRATION_URL to an isolated, preseeded VictoriaLogs test instance")
+	}
+	config := Config{URL: origin, AuthMethod: "none", VerifySSL: true, Timeout: 5 * time.Second}
+	tool := New(nil, nil)
+	base := map[string]interface{}{
+		"query": "myservice", "start": "2026-11-14T18:00:00Z", "end": "2026-11-14T20:00:00Z",
+	}
+	mk := func() map[string]interface{} {
+		c := map[string]interface{}{}
+		for k, v := range base {
+			c[k] = v
+		}
+		return c
+	}
+	rowsArgs := mk()
+	rowsArgs["limit"] = 10
+	raw, err := tool.execute(context.Background(), config, "query", rowsArgs)
+	if err != nil {
+		t.Fatalf("live official LogsQL query: %v", err)
+	}
+	var rows []map[string]interface{}
+	if err := json.Unmarshal([]byte(raw), &rows); err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 3 {
+		t.Fatalf("live query expected three journal entries, got %d: %s", len(rows), raw)
+	}
+	crashes := 0
+	for _, row := range rows {
+		if strings.Contains(row["_msg"].(string), "crash loop") {
+			crashes++
+		}
+	}
+	if crashes != 1 {
+		t.Fatalf("real provider did not return a crash-loop cause: %+v", rows)
+	}
+	hitsArgs := mk()
+	hitsArgs["step"] = "5m"
+	hitsRaw, err := tool.execute(context.Background(), config, "hits", hitsArgs)
+	if err != nil {
+		t.Fatalf("live official hits: %v", err)
+	}
+	var hits struct {
+		Hits []struct {
+			Total int `json:"total"`
+		} `json:"hits"`
+	}
+	if err := json.Unmarshal([]byte(hitsRaw), &hits); err != nil {
+		t.Fatal(err)
+	}
+	if len(hits.Hits) != 1 || hits.Hits[0].Total != 3 {
+		t.Fatalf("live hits mismatch %s", hitsRaw)
+	}
+	fieldsRaw, err := tool.execute(context.Background(), config, "field_names", mk())
+	if err != nil {
+		t.Fatalf("live field_names: %v", err)
+	}
+	if !strings.Contains(fieldsRaw, `"value":"host"`) {
+		t.Fatalf("real field schema missing host: %s", fieldsRaw)
+	}
+	valsArgs := mk()
+	valsArgs["field"] = "host"
+	valsRaw, err := tool.execute(context.Background(), config, "field_values", valsArgs)
+	if err != nil {
+		t.Fatalf("live field_values: %v", err)
+	}
+	var values struct {
+		Values []struct {
+			Value string `json:"value"`
+			Hits  int    `json:"hits"`
+		} `json:"values"`
+	}
+	if err := json.Unmarshal([]byte(valsRaw), &values); err != nil {
+		t.Fatal(err)
+	}
+	count := map[string]int{}
+	for _, v := range values.Values {
+		count[v.Value] = v.Hits
+	}
+	if count["node-a"] != 2 || count["node-b"] != 1 {
+		t.Fatalf("live host distributions %+v", count)
+	}
+	statsArgs := mk()
+	statsArgs["query"] = "myservice | stats by(host) count(*)"
+	statsRaw, err := tool.execute(context.Background(), config, "stats_query", statsArgs)
+	if err != nil {
+		t.Fatalf("live stats_query: %v", err)
+	}
+	var stats struct {
+		Status string `json:"status"`
+		Data   struct {
+			Result []struct {
+				Metric map[string]string `json:"metric"`
+				Value  []interface{}     `json:"value"`
+			} `json:"result"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal([]byte(statsRaw), &stats); err != nil {
+		t.Fatal(err)
+	}
+	if stats.Status != "success" || len(stats.Data.Result) != 2 {
+		t.Fatalf("live stats unexpected: %s", statsRaw)
+	}
+	totals := map[string]string{}
+	for _, row := range stats.Data.Result {
+		if len(row.Value) != 2 {
+			t.Fatalf("invalid stats sample: %s", statsRaw)
+		}
+		v, ok := row.Value[1].(string)
+		if !ok {
+			t.Fatalf("stats sample isn't a string: %s", statsRaw)
+		}
+		totals[row.Metric["host"]] = v
+	}
+	if totals["node-a"] != "2" || totals["node-b"] != "1" {
+		t.Fatalf("unexpected real stats %+v", totals)
+	}
+	t.Log("official pinned VictoriaLogs: all five source-native functions returned consistent logs, hits, field names, field values and stats; node-a crash-loop discriminated")
+}
