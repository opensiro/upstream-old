+	case "victoria_logs":
+		return fmt.Sprintf(`
+**Read-only VictoriaLogs (LogsQL)**
+Use time-bounded RFC3339 start and end, at most six hours. Tool functions:
+- query: query*, start*, end* | limit (1..200)
+- hits: query*, start*, end*, step*
+- field_names: query*, start*, end*
+- field_values: query*, start*, end*, field*
+- stats_query: query* (including a stats pipe), start*, end*
+(* required). Do not log credentials or assume metrics prove a log root cause.
+
+Usage:
+gateway_call("victoria_logs.query", {"query":"myservice", "start":"2026-11-14T18:00:00Z", "end":"2026-11-14T20:00:00Z", "limit":50}, "%s")
+gateway_call("victoria_logs.hits", {"query":"myservice", "start":"2026-11-14T18:00:00Z", "end":"2026-11-14T20:00:00Z", "step":"5m"}, "%s")
+gateway_call("victoria_logs.field_names", {"query":"myservice", "start":"2026-11-14T18:00:00Z", "end":"2026-11-14T20:00:00Z"}, "%s")
+gateway_call("victoria_logs.field_values", {"query":"myservice", "field":"host", "start":"2026-11-14T18:00:00Z", "end":"2026-11-14T20:00:00Z"}, "%s")
+gateway_call("victoria_logs.stats_query", {"query":"myservice | stats by(host) count(*)", "start":"2026-11-14T18:00:00Z", "end":"2026-11-14T20:00:00Z"}, "%s")
+`, logicalName, logicalName, logicalName, logicalName, logicalName)
