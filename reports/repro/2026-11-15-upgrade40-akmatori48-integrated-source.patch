+package services
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/akmatori/akmatori/internal/database"
+	"github.com/akmatori/akmatori/internal/testhelpers"
+)
+
+func TestVictoriaLogsIsSeededDiscoverableAndNamespaceReserved(t *testing.T) {
+	db := testhelpers.NewGlobalSQLiteDB(t, &database.ToolType{}, &database.ToolInstance{})
+	service := NewToolService()
+	if err := service.EnsureToolTypes(); err != nil {
+		t.Fatal(err)
+	}
+	var ty database.ToolType
+	if err := db.Where("name = ?", "victoria_logs").First(&ty).Error; err != nil {
+		t.Fatalf("missing production type seed: %v", err)
+	}
+	if ty.Description == "" {
+		t.Fatal("new tool has no description")
+	}
+	if !isReservedToolNamespace("victoria_logs") {
+		t.Fatal("a custom HTTP/MCP tool can impersonate built-in VictoriaLogs")
+	}
+	found := false
+	for _, entry := range staticCatalog {
+		if entry.ID == "victoria_logs" {
+			if len(entry.ToolTypes) != 1 || entry.ToolTypes[0] != "victoria_logs" || entry.Category != "monitoring" {
+				t.Fatalf("wrong discoverable connector mapping %+v", entry)
+			}
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("VictoriaLogs not discoverable in connector catalog")
+	}
+}
+func TestVictoriaLogsAgentReceivesReadOnlyToolExamples(t *testing.T) {
+	instance := database.ToolInstance{
+		Name: "Site Logs", LogicalName: "site-vlogs",
+		ToolType: database.ToolType{Name: "victoria_logs"},
+	}
+	s := generateToolUsageExample(instance)
+	for _, needle := range []string{
+		"victoria_logs.query", "victoria_logs.hits", "field_names", "field_values", "stats_query",
+		"site-vlogs", "Read-only", "RFC3339",
+	} {
+		if !strings.Contains(s, needle) {
+			t.Errorf("agent connected-tools prompt lacks %q: %s", needle, s)
+		}
+	}
+	if strings.Contains(s, "vl_bearer_token") || strings.Contains(s, "vl_password") {
+		t.Fatal("agent prompt exposes configuration secrets")
+	}
+}
